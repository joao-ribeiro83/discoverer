{
  "name": "@discoverer-neo/migrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discoverer Neo EUL migration tool — imports Oracle Discoverer 4–11 EUL metadata",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "bin": {
    "dn-migrate": "dist/bin.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit false",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "start": "node dist/index.js",
    "cli": "tsx src/bin.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "oracledb": "^6.8.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "xml2js": "^0.6.2",
    "yargs": "^17.7.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/xml2js": "^0.4.14",
    "@types/yargs": "^17.0.33",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
