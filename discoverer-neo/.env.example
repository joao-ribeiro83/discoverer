# =============================================
# Discoverer Neo — Environment Configuration
# =============================================

# --- PostgreSQL ---
# Note: the backend test suite does NOT use this database. It runs against
# `discoverer_neo_test`, created automatically by `npm test` (see
# docs/developer-guide/testing.md). Pointing DATABASE_URL at a non-`_test`
# database while running tests aborts the run rather than wiping your data.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=discoverer_neo
POSTGRES_USER=discoverer
POSTGRES_PASSWORD=change_me_in_production

# Postgres connection-pool ceiling (node-postgres default: 10). Benchmarking
# found this is NOT the bottleneck for metadata reads — raising it to 25 moved
# p95 by ~11% with metadata caching off and by nothing measurable with it on.
# Raise it only for cache-miss-heavy workloads, and raise Postgres'
# max_connections (default 100) alongside it, since workers and psql draw on the
# same budget.
# DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# Read-through caching of EUL metadata (business areas, folders, items) in
# Redis. On by default, and the single largest throughput win measured: at 25
# concurrent users it cut p95 from ~204ms to ~127ms and raised throughput ~55%.
# Mutations invalidate the affected keys immediately; the TTL is only a backstop
# for writers that bypass the API. Set to false to rule the cache out when
# diagnosing metadata that looks stale.
# METADATA_CACHE_ENABLED=true
# METADATA_CACHE_TTL_SECONDS=300

# --- Secrets ---
# Both of these ship with a development default that is printed in this
# repository. The backend REFUSES TO START with NODE_ENV=production while
# either is still set to it.
#
# Generate each with:  openssl rand -hex 32
JWT_SECRET=change_me_generate_a_strong_random_secret

# AES-256-GCM key for stored Oracle data-source passwords. Minimum 32
# characters. CHANGING THIS ON A DEPLOYMENT THAT ALREADY STORES CREDENTIALS
# makes every one of them permanently undecryptable unless you re-encrypt
# first — the rotation runbook is in docs/deployment/configuration.md.
ENCRYPTION_KEY=change_me_generate_a_strong_random_key_32_chars_min

# --- Browser origins ---
# Comma-separated, exact match: scheme + host (+ port), lowercase, no path, no
# trailing slash. The browser sends an Origin header even on same-origin POSTs,
# so the public address users open MUST be listed or login fails. The default
# is the two local dev ports. For the COSEC servers
# (docs/deployment/debian-coexistence.md):
#   test: https://sdocapp01-tst.cosec.pt,https://ssiidonline-test.cosec.pt
#   prod: https://sdocapp01-prod.cosec.pt,https://ssiidonline-prod.cosec.pt
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Oracle connectivity ---
# node-oracledb runs in thin mode by default: pure JavaScript, no Instant
# Client, supports Oracle Database 12.1 and later. Nothing in this app needs
# thick mode.
#
# Set this to true ONLY for EUL sources older than 12.1 (thin mode cannot
# connect to those at all), or if the source mandates native network
# encryption, LDAP naming, or sqlnet.ora — none of which thin mode reads.
# It additionally requires an image built with:
#   docker compose build --build-arg INSTALL_ORACLE_CLIENT=true backend
# The backend exits at startup if this is true without a usable client.
ORACLE_THICK_MODE=false
# Only read when ORACLE_THICK_MODE=true. The images unpack the client here;
# override only if mounting a client from the host.
# ORACLE_CLIENT_PATH=/opt/oracle/instantclient

# Oracle pool sizing, applied PER DATA SOURCE — four Oracle sources at max 10
# can hold 40 sessions open, which must fit the database's own sessions/processes
# limits. Size against concurrent map executions per source, not user count: a
# query holds a connection for its duration, and an export holds one for minutes
# (EXPORT_WORKER_CONCURRENCY claims against this same pool).
# ORACLE_POOL_MIN=2
# ORACLE_POOL_MAX=10
# ORACLE_POOL_INCREMENT=1
# ORACLE_POOL_IDLE_TIMEOUT_SECONDS=300
# ORACLE_CONNECT_TIMEOUT_MS=10000

# --- Backend ---
BACKEND_PORT=3000

# --- Exports ---
# Where generated export files are written. The backend container sets this to
# /app/exports, which docker-compose backs with the `export_files` volume.
# EXPORT_DIR=/app/exports

# Export jobs processed at once by one worker. Each holds an Oracle connection
# for the whole export, and the pool is capped at 10 per data source — keep this
# well under that so exports cannot starve interactive map execution.
EXPORT_WORKER_CONCURRENCY=3

# Run the export worker inside the API process (the default). Set to false and
# run `npm run worker` separately to give exports their own container; watch
# nodejs_eventloop_lag_seconds on /metrics to decide whether that is warranted.
EXPORT_WORKER_ENABLED=true

# Days a generated export file is kept before the retention sweep deletes it.
EXPORT_RETENTION_DAYS=7
EXPORT_CLEANUP_INTERVAL_MINUTES=60

# --- Map runs ---
# Run the map-run worker inside the API process (the default). Set to false
# and run its worker separately to give map runs their own container — same
# rationale as EXPORT_WORKER_ENABLED.
MAP_RUN_WORKER_ENABLED=true

# Map-run jobs processed at once by one worker, across all users.
MAP_RUN_WORKER_CONCURRENCY=3

# Hours a live (unsaved) map run's result is kept before expiry; clamped to
# 24 by liveExpiry.
MAP_RUN_LIVE_TTL_HOURS=24

# Row cap a map run's result is truncated to.
MAP_RUN_MAX_ROWS=100000

# Rows written per JSONB batch when persisting a map run's result.
MAP_RUN_BATCH_SIZE=1000

# How often the map-run cleanup sweep runs, in minutes.
MAP_RUN_CLEANUP_INTERVAL_MINUTES=15

# Hours after which a QUEUED/RUNNING map run is considered stale and marked
# FAILED.
MAP_RUN_STALE_HOURS=24

# --- Schedules ---
# Run the scheduler worker (cron-driven map runs) inside the API process (the
# default). Set to false and run `npm run worker:scheduler` separately to give
# scheduled runs their own container — same rationale as EXPORT_WORKER_ENABLED.
SCHEDULER_WORKER_ENABLED=true

# Where files produced by scheduled runs are written. Defaults to a path under
# the backend working directory; set to a mounted volume path in containers
# (kept separate from EXPORT_DIR — scheduled results outlive a single export
# job and are not subject to the export retention sweep).
# SCHEDULE_RESULT_DIR=/app/scheduled-results

# --- Migration: provisioned user credentials ---
# Where a migration writes the temporary-password file for the accounts it
# creates. Dev compose sets this to /app/credentials, bind-mounted to
# ./credentials on the host so you can collect the file and delete it.
#
# The file contains WORKING PASSWORDS. It is never served over the API and
# never logged. Deliver the passwords, then delete it.
# See docs/migration/user-credentials.md
# CREDENTIALS_DIR=/app/credentials
#
# Hours a credential file survives before the app deletes it. The sweep runs
# at boot and hourly.
# CREDENTIAL_FILE_TTL_HOURS=24

# --- Frontend ---
FRONTEND_PORT=5173

# --- Row-level security ---
# What to do with a folder no active row-level policy resolves for.
# CLOSED (the default) refuses it — with zero policies defined that refuses
# every map run, for everyone, administrators included. OPEN runs a folder no
# active policy reaches, unfiltered, the way Discoverer itself did. Set OPEN
# only while no policy exists; switch back to CLOSED as soon as one does.
# ROW_LEVEL_FAIL_MODE=CLOSED

# --- Node thread pool (only matters with ORACLE_THICK_MODE=true) ---
# Thick-mode Oracle occupies a libuv thread pool slot for the whole of every
# call, and Node's default pool is 4 threads — shared with DNS lookups. Once
# ORACLE_POOL_MAX concurrent queries exceed it, a NEW Postgres connection
# cannot resolve its hostname and fails on DATABASE_POOL_CONNECTION_TIMEOUT_MS,
# producing a 500 that names Postgres for a problem caused by Oracle.
# Keep this at ORACLE_POOL_MAX plus headroom. The backend warns at boot if it
# is too low; libuv reads the value at startup, so it cannot be fixed in code.
# UV_THREADPOOL_SIZE=16

# --- Query timeouts ---
# How long a map's statement may run on Oracle. These were hard-coded at 30
# seconds with no override, which turns an ordinary end-of-month report into
# "Query timed out" — a Discoverer estate routinely has reports taking minutes.
# QUERY_TIMEOUT_MS is what a request gets when it asks for nothing;
# QUERY_TIMEOUT_MAX_MS is the ceiling it may ask for.
# A long SYNCHRONOUS run must also survive proxy_read_timeout in
# frontend/nginx.conf, which is set to match. For anything genuinely long, the
# background run is the better tool — it polls, so no request stays open.
# Note: this becomes connection.callTimeout, which in thick mode bounds each
# ROUND TRIP, not the whole statement — a 5-minute setting let a real map run
# for ten. Use the background run when a hard wall-clock bound matters.
# QUERY_TIMEOUT_MS=300000
# QUERY_TIMEOUT_MAX_MS=1800000

# Seconds a list-of-values page stays cached. The query behind a pick-list is a
# SELECT DISTINCT over a fact table — 16-27s each on the reference estate — so
# a short TTL makes every prompt pay it again. The values are a prompt, not an
# answer: whatever is picked is queried live.
# LOV_CACHE_TTL_SECONDS=3600

# --- Oracle session NLS ---
# Discoverer ran every query under the author's own NLS, and the formulas it
# stored assume it. The reference estate has
#   TO_NUMBER(REPLACE("PREMIO_MIN", '.', ','))
# which swaps the dot for a comma — that only reads as a number where the comma
# IS the decimal separator. With the session on '.,' the map failed with
# ORA-01722 on data reading 458.33, and the user saw only "The query could not
# be completed". Unset leaves the session exactly as the database hands it over.
# ORACLE_NLS_NUMERIC_CHARACTERS=,.
# ORACLE_NLS_DATE_FORMAT=RR.MM.DD
# ORACLE_NLS_DATE_LANGUAGE=PORTUGUESE
