# =============================================
# Discoverer Neo — Frontend Dev Dockerfile
# For development with Vite hot reload
# =============================================

FROM node:22-bookworm-slim

WORKDIR /app

# Install dependencies first for better layer caching
COPY package.json package-lock.json* ./
# The base image's npm 10.9.8 crashes resolving this peer-dependency graph
# (arborist bug: "Cannot read properties of null (reading 'edgesOut')" in
# #loadPeerSet) — npm 11+ does not have this bug.
RUN npm install -g npm@11 && npm install

# Copy source
COPY . .

ENV NODE_ENV=development
ENV FRONTEND_PORT=5173
EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0"]
