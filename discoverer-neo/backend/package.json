{
  "name": "@discoverer-neo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discoverer Neo backend - Node.js 22 + TypeScript + Fastify API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @discoverer-neo/core",
    "build": "tsc --noEmit false -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/export.standalone.ts",
    "worker:start": "node dist/workers/export.standalone.js",
    "worker:scheduler": "tsx src/workers/scheduler.standalone.ts",
    "worker:scheduler:start": "node dist/workers/scheduler.standalone.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretypecheck": "npm run build -w @discoverer-neo/core",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --testPathPattern='integration'",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "verify": "tsx src/scripts/verify-migration.ts",
    "generate-spec": "tsx src/scripts/generate-spec.ts",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "db:test:reset": "node scripts/setup-test-db.mjs --recreate",
    "pretest": "npm run db:test:setup"
  },
  "dependencies": {
    "@discoverer-neo/core": "*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.6",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "node-sql-parser": "^5.4.0",
    "oracledb": "^6.0.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.0",
    "@types/oracledb": "^6.0.0",
    "@types/pg": "^8.11.0",
    "bs-logger": "^0.2.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jest": "^29.0.0",
    "lodash.memoize": "^4.1.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
