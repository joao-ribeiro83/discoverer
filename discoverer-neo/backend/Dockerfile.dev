# =============================================
# Discoverer Neo — Backend Dev Dockerfile
# For development with hot reload
# =============================================
# Build context is the REPO ROOT, not backend/ — same reason as the production
# backend/Dockerfile: this is an npm workspaces monorepo, the backend depends
# on @discoverer-neo/core ("*", a workspace-only reference — see
# backend/package.json), and the only lockfile is the root package-lock.json.
# =============================================

FROM node:22-bookworm-slim

# Install Oracle Instant Client runtime dependencies
RUN apt-get update \
  && apt-get install -y --no-install-recommends libaio1 curl unzip ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Oracle Instant Client — opt-in, mirroring the production Dockerfile. Thin mode
# is the default and needs none of this; the client only matters for EUL sources
# older than 12.1. Enable with --build-arg INSTALL_ORACLE_CLIENT=true.
ARG INSTALL_ORACLE_CLIENT=false
ARG ORACLE_CLIENT_URL="https://download.oracle.com/otn_software/linux/instantclient/1931000/instantclient-basic-linux.x64-19.31.0.0.0dbru.zip"
RUN set -eu; \
  mkdir -p /opt/oracle/instantclient; \
  if [ "$INSTALL_ORACLE_CLIENT" != "true" ]; then \
    echo "INSTALL_ORACLE_CLIENT is not true — skipping (thin mode)."; \
  else \
    curl -fsSL -o /tmp/ic.zip "$ORACLE_CLIENT_URL"; \
    unzip -q /tmp/ic.zip -d /tmp/ic; \
    mv /tmp/ic/instantclient_*/* /opt/oracle/instantclient/; \
    test -e /opt/oracle/instantclient/libclntsh.so; \
    rm -rf /tmp/ic /tmp/ic.zip; \
  fi

ENV LD_LIBRARY_PATH=/opt/oracle/instantclient
ENV PATH=/opt/oracle/instantclient:$PATH

WORKDIR /app

# Every workspace manifest has to be present for npm to reconcile the root
# lockfile, even though only backend (+ its migrate dependency) get installed —
# same reasoning as the production Dockerfile's "manifests" stage.
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
COPY migrate/package.json migrate/
RUN npm ci --workspace @discoverer-neo/backend --workspace @discoverer-neo/core --include-workspace-root

# Both workspace tsconfigs extend this root one (skipLibCheck etc.) — without
# it here, `tsc -p migrate/tsconfig.json` silently drops the extends and fully
# type-checks drizzle-orm's bundled multi-dialect .d.ts files.
COPY tsconfig.json ./

# migrate first: the backend imports it as a built package (dist/index.js),
# resolved through the node_modules workspace symlink — tsx watching the
# backend's own src does not transpile migrate, so it must already be built.
COPY migrate/tsconfig.json migrate/
# jest.config.js too — not needed to build, but without it `npx jest` inside
# this container falls back to jest's own defaults (plain babel, no ESM, no
# path aliases) instead of erroring, which reads as "tests pass" right up
# until they report zero tests collected. Needed to run migrate/src/scripts'
# dev tooling and its tests (see migrate/src/scripts/README.md).
COPY migrate/jest.config.js migrate/
COPY migrate/src migrate/src
RUN npm run build --workspace @discoverer-neo/core

COPY backend/tsconfig*.json backend/
COPY backend/drizzle.config.ts backend/
# `drizzle-kit migrate` reads the .sql files and meta/_journal.json from
# `out: './drizzle'` at runtime. Without them, `docker compose exec backend npm
# run db:migrate` fails with "Can't find meta/_journal.json" — which is how this
# database's schema once ended up ahead of its own bookkeeping. docker-compose.dev.yml
# also bind-mounts this directory, so a freshly generated migration is picked up
# without a rebuild; the COPY is what makes the image correct on its own.
COPY backend/drizzle backend/drizzle
COPY backend/src backend/src

ENV NODE_ENV=development
WORKDIR /app/backend
EXPOSE 3000 9229

CMD ["npx", "tsx", "watch", "src/server.ts"]
