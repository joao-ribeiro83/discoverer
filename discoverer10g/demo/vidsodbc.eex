<ComplexObject CBOHint="" Description="This folder groups together store and sales details" DeveloperKey="NEWFOLDER11" DeveloperKeyFrozen="False" DistinctFlag="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Hidden="False" Id="104356" Name="Stores and Sales Details" NonDeterministic="False" SQL="( SELECT i104413 AS i104448, i104419 AS i104456, i104420 AS i104460, i104421 AS i104470, i104422 AS i104472, i104425 AS i104474, i104429 AS i104478, i104431 AS i104484, i104435 AS i104500, i104437 AS i104504, i104443 AS i104506, i104510 AS i104514, i104524 AS i104539 FROM ( SELECT AGE_CATEGORY AS i104409, BRAND AS i104412, DEPARTMENT AS i104419, DESCRIPTION AS i104420, FULL_DESCRIPTION AS i104422, PRODUCT_CATEGORY AS i104425, PRODUCT_KEY AS i104426, PRODUCT_TYPE AS i104428 FROM VIDEO5.PRODUCT ) IO104349, ( SELECT COST AS i104414, CUSTOMER_COUNT AS i104415, PRODUCT_KEY AS i104427, PROFIT AS i104429, SALES AS i104432, STORE_KEY AS i104433, TIME_KEY AS i104439, UNIT_SALES AS i104445 FROM VIDEO5.SALES_FACT ) IO104350, ( SELECT CITY AS i104413, FLOOR_PLAN_TYPE AS i104421, REGION AS i104430, REPORTS AS i104431, STORE_KEY AS i104434, STORE_NAME AS i104435, STORE_SIZE AS i104437 FROM VIDEO5.STORE ) IO104351, ( SELECT DAY_OF_WEEK AS i104417, HOLIDAY_FLAG AS i104423, TIME_KEY AS i104441, TRANSACTION_DATE AS i104443, TRANSACTION_DATE AS i104508, TRANSACTION_DATE AS i104510, TRANSACTION_DATE AS i104518, TRANSACTION_DATE AS i104524 FROM VIDEO5.TIMES ) IO104353  WHERE (i104441 = i104439) AND (i104426 = i104427) AND (i104434 = i104433) )" UserProperty1="" UserProperty2="">
