<ComplexObject CBOHint="" Description="Monthly Sales Analysis" DeveloperKey="NEWFOLDER12" DeveloperKeyFrozen="False" DistinctFlag="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Hidden="False" Id="104357" Name="Monthly Sales Analysis" NonDeterministic="False" SQL="( SELECT i104446 AS i104450, i104454 AS i104458, i104480 AS i104482, SUM(i104486) AS i104491, i104498 AS i104502, i104512 AS i104516, i104520 AS i104522, i104526 AS i104541 FROM ( SELECT i104413 AS i104446, i104414 AS i104452, i104419 AS i104454, i104429 AS i104476, i104430 AS i104480, i104432 AS i104486, i104435 AS i104498, i104510 AS i104512, i104518 AS i104520, i104524 AS i104526, i104445 AS i104543 FROM ( SELECT AGE_CATEGORY AS i104409, BRAND AS i104412, DEPARTMENT AS i104419, DESCRIPTION AS i104420, FULL_DESCRIPTION AS i104422, PRODUCT_CATEGORY AS i104425, PRODUCT_KEY AS i104426, PRODUCT_TYPE AS i104428 FROM VIDEO5.PRODUCT ) IO104349, ( SELECT COST AS i104414, CUSTOMER_COUNT AS i104415, PRODUCT_KEY AS i104427, PROFIT AS i104429, SALES AS i104432, STORE_KEY AS i104433, TIME_KEY AS i104439, UNIT_SALES AS i104445 FROM VIDEO5.SALES_FACT ) IO104350, ( SELECT CITY AS i104413, FLOOR_PLAN_TYPE AS i104421, REGION AS i104430, REPORTS AS i104431, STORE_KEY AS i104434, STORE_NAME AS i104435, STORE_SIZE AS i104437 FROM VIDEO5.STORE ) IO104351, ( SELECT DAY_OF_WEEK AS i104417, HOLIDAY_FLAG AS i104423, TIME_KEY AS i104441, TRANSACTION_DATE AS i104443, TRANSACTION_DATE AS i104508, TRANSACTION_DATE AS i104510, TRANSACTION_DATE AS i104518, TRANSACTION_DATE AS i104524 FROM VIDEO5.TIMES ) IO104353  WHERE (i104441 = i104439) AND (i104426 = i104427) AND (i104434 = i104433) ) IO104355  GROUP BY i104446, i104454, i104480, i104498, i104512, i104520, i104526 )" UserProperty1="" UserProperty2="">
