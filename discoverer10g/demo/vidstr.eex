<ComplexObject CBOHint="" Description="This folder groups together store and sales details" DeveloperKey="DC_STORE_AND_SALES_DETAILS" DeveloperKeyFrozen="False" DistinctFlag="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Hidden="False" Id="100529" Name="Stores and Sales Details" NonDeterministic="False" SQL="( SELECT i100592 AS i100627, i100593 AS i100633, i100594 AS i100643, i100595 AS i100645, i100598 AS i100647, i100602 AS i100649, i100604 AS i100657, i100608 AS i100671, i100609 AS i100677, i100616 AS i100679, i100683 AS i100685, i100697 AS i100699, i100586 AS i100619 FROM ( SELECT DAY_OF_WEEK AS i100589, HOLIDAY_FLAG AS i100596, TIME_KEY AS i100612, TRANSACTION_DATE AS i100616, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;DD&apos;),&apos;DD&apos;) || &apos;190001&apos;,&apos;DDYYYYMM&apos;)) AS i100681, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;MM&apos;),&apos;MM&apos;) || &apos;1900&apos;,&apos;MMYYYY&apos;)) AS i100683, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;Q&apos;),&apos;MM&apos;) || &apos;1900&apos;,&apos;MMYYYY&apos;)) AS i100691, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;YYYY&apos;),&apos;YYYY&apos;) || &apos;01&apos;,&apos;YYYYMM&apos;)) AS i100697 FROM VIDEO5.TIMES ) IO100522, ( SELECT AGE_CATEGORY AS i100582, BRAND AS i100585, DEPARTMENT AS i100592, DESCRIPTION AS i100593, FULL_DESCRIPTION AS i100595, PRODUCT_CATEGORY AS i100598, PRODUCT_KEY AS i100599, PRODUCT_TYPE AS i100601 FROM VIDEO5.PRODUCT ) IO100524, ( SELECT COST AS i100587, CUSTOMER_COUNT AS i100588, PRODUCT_KEY AS i100600, PROFIT AS i100602, SALES AS i100605, STORE_KEY AS i100606, TIME_KEY AS i100614, UNIT_SALES AS i100618 FROM VIDEO5.SALES_FACT ) IO100525, ( SELECT CITY AS i100586, FLOOR_PLAN_TYPE AS i100594, REGION AS i100603, REPORTS AS i100604, STORE_KEY AS i100607, STORE_NAME AS i100608, STORE_SIZE AS i100609 FROM VIDEO5.STORE ) IO100526  WHERE (i100599 = i100600) AND (i100612 = i100614) AND (i100607 = i100606) )" UserProperty1="" UserProperty2="">
