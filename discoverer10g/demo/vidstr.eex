<ServerMaterialisedSDO Active="False" BitmapPosition="1" DatabaseLink="" DeveloperKeyFrozen="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Id="100839" Internal="False" ItemDeleted="False" ItemModified="False" JoinState="Valid" LastRefresh="" NumAxisItems="7" NumJoins="0" NumRows="" NumTimesUsed="0" ObjectSQL1="" ObjectSQL2="" ObjectSQL3="" RefreshRequired="False" SQL="SELECT CAL_DATE_MON AS i100687, CAL_DATE_QTR AS i100693, CAL_DATE_YR AS i100701, CITY AS i100621, DEPARTMENT AS i100629, REGION AS i100653, STORE_NAME AS i100673, COST_SUM AS &quot;SUM(i100625)&quot;, PROFIT_SUM AS &quot;SUM(i100651)&quot;, SALES_SUM AS &quot;SUM(i100659)&quot;, UNIT_SALES_SUM AS &quot;SUM(i100716)&quot;, COST_COUNT AS &quot;COUNT(i100625)&quot;, PROFIT_COUNT AS &quot;COUNT(i100651)&quot;, SALES_COUNT AS &quot;COUNT(i100659)&quot;, UNIT_SALES_COUNT AS &quot;COUNT(i100716)&quot; FROM (SELECT DECODE(TIMES.TRANSACTION_DATE,NULL,TO_DATE(NULL,&apos;MMDDYYYY&apos;),TO_DATE(TO_CHAR(TRUNC(TIMES.TRANSACTION_DATE,&apos;MM&apos;),&apos;MM&apos;)||&apos;1900&apos;,&apos;MMYYYY&apos;)) AS CAL_DATE_MON, DECODE(TIMES.TRANSACTION_DATE,NULL,TO_DATE(NULL,&apos;MMDDYYYY&apos;),TO_DATE(TO_CHAR(TRUNC(TIMES.TRANSACTION_DATE,&apos;Q&apos;),&apos;MM&apos;)||&apos;1900&apos;,&apos;MMYYYY&apos;)) AS CAL_DATE_QTR, DECODE(TIMES.TRANSACTION_DATE,NULL,TO_DATE(NULL,&apos;MMDDYYYY&apos;),TO_DATE(TO_CHAR(TRUNC(TIMES.TRANSACTION_DATE,&apos;YYYY&apos;),&apos;YYYY&apos;)||&apos;01&apos;,&apos;YYYYMM&apos;)) AS CAL_DATE_YR, STORE.CITY AS CITY, PRODUCT.DEPARTMENT AS DEPARTMENT, STORE.REGION AS REGION, STORE.STORE_NAME AS STORE_NAME, SUM(SALES_FACT.COST) AS COST_SUM, SUM(SALES_FACT.PROFIT) AS PROFIT_SUM, SUM(SALES_FACT.SALES) AS SALES_SUM, SUM(SALES_FACT.UNIT_SALES) AS UNIT_SALES_SUM, COUNT(SALES_FACT.COST) AS COST_COUNT, COUNT(SALES_FACT.PROFIT) AS PROFIT_COUNT, COUNT(SALES_FACT.SALES) AS SALES_COUNT, COUNT(SALES_FACT.UNIT_SALES) AS UNIT_SALES_COUNT&#x000a;FROM VIDEO5.TIMES TIMES, VIDEO5.PRODUCT PRODUCT, VIDEO5.SALES_FACT SALES_FACT, VIDEO5.STORE STORE&#x000a;WHERE ( TIMES.TIME_KEY = SALES_FACT.TIME_KEY ) AND ( PRODUCT.PRODUCT_KEY = SALES_FACT.PRODUCT_KEY ) AND ( STORE.STORE_KEY = SALES_FACT.STORE_KEY )&#x000a;GROUP BY STORE.CITY, PRODUCT.DEPARTMENT, STORE.REGION, STORE.STORE_NAME, DECODE(TIMES.TRANSACTION_DATE,NULL,TO_DATE(NULL,&apos;MMDDYYYY&apos;),TO_DATE(TO_CHAR(TRUNC(TIMES.TRANSACTION_DATE,&apos;MM&apos;),&apos;MM&apos;)||&apos;1900&apos;,&apos;MMYYYY&apos;)), DECODE(TIMES.TRANSACTION_DATE,NULL,TO_DATE(NULL,&apos;MMDDYYYY&apos;),TO_DATE(TO_CHAR(TRUNC(TIMES.TRANSACTION_DATE,&apos;Q&apos;),&apos;MM&apos;)||&apos;1900&apos;,&apos;MMYYYY&apos;)), DECODE(TIMES.TRANSACTION_DATE,NULL,TO_DATE(NULL,&apos;MMDDYYYY&apos;),TO_DATE(TO_CHAR(TRUNC(TIMES.TRANSACTION_DATE,&apos;YYYY&apos;),&apos;YYYY&apos;)||&apos;01&apos;,&apos;YYYYMM&apos;))&#x000a;)" ServerErrorCode="" ServerErrorText="" TableName="VIDEO_SUMM_ALL" TableOwner="VIDEO5" Validity="False" WrapperSQL="SELECT CAL_DATE_MON AS i100687, CAL_DATE_QTR AS i100693, CAL_DATE_YR AS i100701, CITY AS i100621, DEPARTMENT AS i100629, REGION AS i100653, STORE_NAME AS i100673, COST_SUM AS &quot;SUM(i100625)&quot;, PROFIT_SUM AS &quot;SUM(i100651)&quot;, SALES_SUM AS &quot;SUM(i100659)&quot;, UNIT_SALES_SUM AS &quot;SUM(i100716)&quot;, COST_COUNT AS &quot;COUNT(i100625)&quot;, PROFIT_COUNT AS &quot;COUNT(i100651)&quot;, SALES_COUNT AS &quot;COUNT(i100659)&quot;, UNIT_SALES_COUNT AS &quot;COUNT(i100716)&quot; FROM ">
