<ComplexObject CBOHint="" Description="Monthly Sales Analysis" DeveloperKey="DC_MONTHLY_SALES_ANALYSIS" DeveloperKeyFrozen="False" DistinctFlag="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Hidden="False" Id="100528" Name="Monthly Sales Analysis" NonDeterministic="False" SQL="( SELECT i100621 AS i100623, i100629 AS i100631, i100653 AS i100655, SUM(i100659) AS i100664, i100673 AS i100675, i100687 AS i100689, i100693 AS i100695, i100701 AS i100714 FROM ( SELECT i100586 AS i100621, i100587 AS i100625, i100592 AS i100629, i100602 AS i100651, i100603 AS i100653, i100605 AS i100659, DECODE(LEAST(GREATEST(( i100605 ),0),50),( i100605 ),&apos;0-50&apos;,DECODE(LEAST(GREATEST(( i100605 ),50.01),100),( i100605 ),&apos;51-100&apos;,DECODE(LEAST(GREATEST(( i100605 ),100.01),200),( i100605 ),&apos;101-200&apos;,DECODE(LEAST(GREATEST(( i100605 ),200.01),99999),( i100605 ),&apos;&gt;200&apos;,&apos;NOT IN BAND&apos;)))) AS i100668, i100608 AS i100673, i100683 AS i100687, i100691 AS i100693, i100697 AS i100701, i100618 AS i100716 FROM ( SELECT DAY_OF_WEEK AS i100589, HOLIDAY_FLAG AS i100596, TIME_KEY AS i100612, TRANSACTION_DATE AS i100616, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;DD&apos;),&apos;DD&apos;) || &apos;190001&apos;,&apos;DDYYYYMM&apos;)) AS i100681, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;MM&apos;),&apos;MM&apos;) || &apos;1900&apos;,&apos;MMYYYY&apos;)) AS i100683, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;Q&apos;),&apos;MM&apos;) || &apos;1900&apos;,&apos;MMYYYY&apos;)) AS i100691, decode(TRANSACTION_DATE,null,to_date(null, &apos;MMDDYYYY&apos;),to_date(to_char(trunc(TRANSACTION_DATE,&apos;YYYY&apos;),&apos;YYYY&apos;) || &apos;01&apos;,&apos;YYYYMM&apos;)) AS i100697 FROM VIDEO5.TIMES ) IO100522, ( SELECT AGE_CATEGORY AS i100582, BRAND AS i100585, DEPARTMENT AS i100592, DESCRIPTION AS i100593, FULL_DESCRIPTION AS i100595, PRODUCT_CATEGORY AS i100598, PRODUCT_KEY AS i100599, PRODUCT_TYPE AS i100601 FROM VIDEO5.PRODUCT ) IO100524, ( SELECT COST AS i100587, CUSTOMER_COUNT AS i100588, PRODUCT_KEY AS i100600, PROFIT AS i100602, SALES AS i100605, STORE_KEY AS i100606, TIME_KEY AS i100614, UNIT_SALES AS i100618 FROM VIDEO5.SALES_FACT ) IO100525, ( SELECT CITY AS i100586, FLOOR_PLAN_TYPE AS i100594, REGION AS i100603, REPORTS AS i100604, STORE_KEY AS i100607, STORE_NAME AS i100608, STORE_SIZE AS i100609 FROM VIDEO5.STORE ) IO100526  WHERE (i100599 = i100600) AND (i100612 = i100614) AND (i100607 = i100606) ) IO100530  GROUP BY i100621, i100629, i100653, i100673, i100687, i100693, i100701 )" UserProperty1="" UserProperty2="">
