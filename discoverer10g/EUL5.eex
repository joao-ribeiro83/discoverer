<ComplexObject CBOHint="" Description="" DeveloperKey="EUL5_WORKBOOK_MGMT" DeveloperKeyFrozen="False" DistinctFlag="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Hidden="False" Id="100091" Name="EUL5 Workbook Management" NonDeterministic="False" SQL="( SELECT i100310 AS i101132, i100311 AS i101134, NVL(i100551,&apos;Document Not Shared&apos;) AS i101183, i100469 AS i101185, i100470 AS i101187, DECODE(EUL5.EUL5_GET_ISITAPPS_EUL,1,EUL5.EUL5_GET_APPS_USERRESP(i100471),i100471) AS i101189, i100472 AS i101193, i100473 AS i101195, i100474 AS i101197, i100478 AS i101199, i100479/1024 AS i101203, i100480 AS i101205, DECODE(EUL5.EUL5_GET_ISITAPPS_EUL,1,EUL5.EUL5_GET_APPS_USERRESP(i100481),i100481) AS i101207, i100482 AS i101211 FROM ( SELECT AP_CREATED_BY AS i100310, AP_CREATED_DATE AS i100311, AP_EU_ID AS i100313, AP_ID AS i100314, AP_PRIV_LEVEL AS i100315, AP_TYPE AS i100316, GBA_BA_ID AS i100653, GP_APP_ID AS i100655, GD_DOC_ID AS i100654, AP_ELEMENT_STATE AS i100312, AP_UPDATED_BY AS i100317, AP_UPDATED_DATE AS i100318, NOTM AS i100783 FROM EUL5.EUL5_ACCESS_PRIVS ) IO100019, ( SELECT DOC_BATCH AS i100469, DOC_CONTENT_TYPE AS i100470, DOC_CREATED_BY AS i100471, DOC_CREATED_DATE AS i100472, DOC_DESCRIPTION AS i100473, DOC_DEVELOPER_KEY AS i100474, DOC_ID AS i100478, DOC_LENGTH AS i100479, DOC_NAME AS i100480, DOC_UPDATED_BY AS i100481, DOC_UPDATED_DATE AS i100482, DOC_EU_ID AS i100477, DOC_DOCUMENT AS i100475, DOC_ELEMENT_STATE AS i100476, DOC_USER_PROP1 AS i100483, DOC_USER_PROP2 AS i100484, NOTM AS i100798 FROM EUL5.EUL5_DOCUMENTS WHERE (DOC_CONTENT_TYPE = &apos;application/vnd.oracle-disco.wb&apos;) ) IO100035, ( SELECT EU_USERNAME AS i100551, EU_BATCH_CMT_SZ AS i100532, EU_BATCH_EXPIRY AS i100533, EU_BATCH_JOBS_LMT AS i100534, EU_BATCH_QTIME_LMT AS i100535, EU_BATCH_REP_USER AS i100536, EU_BATCH_WND_END AS i100537, EU_BATCH_WND_START AS i100538, EU_QUERY_EST_LMT AS i100544, EU_QUERY_TIME_LMT AS i100545, EU_ROLE_FLAG AS i100546, EU_ROW_FETCH_LMT AS i100547, EU_USE_PUB_PRIVS AS i100552, EU_ID AS i100542, EU_CREATED_BY AS i100539, EU_CREATED_DATE AS i100540, EU_ELEMENT_STATE AS i100541, EU_LAST_BATCH_ACC AS i100543, EU_SECURITY_MODEL AS i100548, EU_UPDATED_BY AS i100549, EU_UPDATED_DATE AS i100550, NOTM AS i100800 FROM EUL5.EUL5_EUL_USERS ) IO100038  WHERE (i100478 = i100654(+)) AND (i100542(+) = i100313) AND (( i100470 ) = &apos;application/vnd.oracle-disco.wb&apos;) )" UserProperty1="" UserProperty2="">
