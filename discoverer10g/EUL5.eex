<ComplexObject CBOHint="" Description="" DeveloperKey="EUL5_EXST_SUMM_COMBOS" DeveloperKeyFrozen="False" DistinctFlag="False" ExternalDatabaseLink="" ExternalObjectName="" ExternalObjectOwner="" Hidden="False" Id="100075" Name="EUL5 Existing Summary Combos " NonDeterministic="False" SQL="( SELECT i100399 AS i101166, i100580 AS i101399, i100743 AS i101582, i100888 AS i101760, i100968 AS i101786, i100974 AS i101788, i101054 AS i101812, i101057 AS i101816, i101061 AS i101818, i101063 AS i101820, i101064 AS i101826, i101065 AS i101832, i101067 AS i101836, i101070 AS i101840, DECODE(i101070,6,&apos;External&apos;,&apos;Internal&apos;) AS i101851, i101092 AS i101867, i101094 AS i101871, i101100 AS i101877, i101102 AS i101879, i101108 AS i101881, i101115 AS i101890 FROM ( SELECT SUMO_ACTIVE AS i101076, EMS_COMMIT_SIZE AS i100528, EMS_STATE AS i100530, MSDO_REFRESH_REQD AS i100768, MSDO_SVR_ERR_CODE AS i100770, MSDO_SVR_ERR_TEXT AS i100772, NOTM AS i100821, SBO_MAX_ITEM_COMB AS i100948, SBO_SRS_ID AS i100950, SDO_BITMAP_POS AS i100964, SDO_DATABASE_LINK AS i100966, SDO_LAST_REFRESH AS i100968, SDO_NUM_AXIS_ITEMS AS i100970, SDO_NUM_JOINS AS i100972, SDO_NUM_ROWS AS i100974, SDO_NUM_USGS AS i100976, SDO_OBJECT_SQL1 AS i100978, SDO_OBJECT_SQL2 AS i100980, SDO_OBJECT_SQL3 AS i100982, SDO_SBO_ID AS i100984, SDO_TABLE_NAME AS i100986, SDO_TABLE_OWNER AS i100988, SUMO_ASMP_ID AS i101078, SUMO_CREATED_BY AS i101080, SUMO_CREATED_DATE AS i101082, SUMO_ELEMENT_STATE AS i101084, SUMO_EXT_DB_LINK AS i101086, SUMO_EXT_OBJECT AS i101088, SUMO_EXT_OWNER AS i101090, SUMO_ID AS i101092, SUMO_INTERNAL AS i101094, SUMO_ITEM_DELETED AS i101096, SUMO_ITEM_MODIFIED AS i101098, SUMO_JOIN_STATE AS i101100, SUMO_TYPE AS i101102, SUMO_UPDATED_BY AS i101104, SUMO_UPDATED_DATE AS i101106, SUMO_VALIDITY AS i101108 FROM EUL5.EUL5_SUMMARY_OBJS ) IO100065, ( SELECT SRS_AUTO_REFRESH AS i101054, NOTM AS i100825, SRS_CREATED_BY AS i101055, SRS_CREATED_DATE AS i101056, SRS_DESCRIPTION AS i101057, SRS_DEVELOP